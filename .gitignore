# PlatformIO
.pio/
.pioenvs/
.piolibdeps/

# Editors
.vscode/
.idea/
*.swp

# Python (build scripts)
__pycache__/
*.pyc

# Build output generated by scripts/library_build.py.  The header lands in the
# consuming project's build directory, but keep this rule so a stray copy in
# the library tree is never committed by accident.
wuadvi_rp_payload.h

# The RP2354B firmware binary is NOT vendored: scripts/library_build.py fetches
# the pinned release and caches it here.  The two text files that pin it
# (assets/rp-firmware/VERSION and SHA256) ARE tracked.
assets/rp-firmware/*.uf2

# OS noise
.DS_Store
Thumbs.db
