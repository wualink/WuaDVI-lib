# PlatformIO
.pio/
.pioenvs/
.piolibdeps/

# Editors
.vscode/
.idea/
*.swp

# Python (build scripts)
__pycache__/
*.pyc

# Build output generated by scripts/library_build.py.  Under PlatformIO the
# header lands in the consuming project's build directory; under ESPHome it is
# written beside the library, in wuadvi_generated/ — inside this very folder
# when a project references a local checkout.  Never committed either way.
wuadvi_rp_payload.h
wuadvi_generated/

# The RP2354B firmware binary is NOT vendored: scripts/library_build.py fetches
# the pinned release and caches it here.  The two text files that pin it
# (assets/rp-firmware/VERSION and SHA256) ARE tracked.
assets/rp-firmware/*.uf2

# OS noise
.DS_Store
Thumbs.db
